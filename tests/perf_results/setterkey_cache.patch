 // Whether this string is itself a property-setter key, i.e. ends in "=".
diff --git a/cpp/core/value_string.cpp b/cpp/core/value_string.cpp
index 28b1ec6..3d9520c 100644
--- a/cpp/core/value_string.cpp
+++ b/cpp/core/value_string.cpp
@@ -512,6 +512,36 @@ int   Value::Compare(Value b) const      { return string_compare(*this, b); }
