+// PROTOTYPE (scratch/setterkey-cache): SetterKey() for names over 4 bytes used to
+// allocate and intern a fresh "name=" string on every assignment to an object whose
+// chain holds a setter.  Cache the result, keyed by the exact key Value.  Both the
+// key and its setter are GC roots, so neither can be freed and the key's bits cannot
+// be reused for a different string.  Bounded: after 512 distinct keys it just
+// builds the string as before.
+namespace {
+struct SetterKeyEntry { uint64_t key; uint64_t setter; };
+SetterKeyEntry g_setterCache[1024];   // open addressing, linear probe
+int g_setterCacheCount = 0;
+}
+Value Value::SetterKeySlow() const {
+    size_t i = (size_t)((bits >> 3) * 0x9E3779B97F4A7C15ULL >> 54) & 1023;
+    for (int probe = 0; probe < 8; probe++, i = (i + 1) & 1023) {
+        SetterKeyEntry& e = g_setterCache[i];
+        if (e.key == bits) return Value::fromBits(e.setter);
+        if (e.key == 0) {
+            Value made = Value::make_string(String(AsCString()) + "=");
+            if (g_setterCacheCount < 512) {
+                GCManager::AddRoot(*this);
+                GCManager::AddRoot(made);
+                e.key = bits; e.setter = made.bits;
+                g_setterCacheCount++;
+            }
+            return made;
+        }
+    }
+    return Value::make_string(String(AsCString()) + "=");
+}
